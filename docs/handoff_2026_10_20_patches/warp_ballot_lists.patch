+// Lane-ordered appends of one checklist pass to its interaction lists. A lane
+// picks at most one list per check; one ballot per list gives every picking lane
+// its slot and the warp the count, so the sizes stay in warp-uniform registers.
+// The entries are written into the vectors' storage ahead of their size, which
+// is published (setSize) only when a list outgrows its storage and, for the
+// lists that grew, once in flush().
+template <int nLists>
+class CudaKickListAppender {
+    DeviceVector<int>* lists_[nLists];
+    int sizes_[nLists];
+
+public:
+    __device__ explicit CudaKickListAppender(DeviceVector<int>* const (&lists)[nLists]) {
+        for (int n = 0; n < nLists; n++) {
+            lists_[n] = lists[n];
+            sizes_[n] = lists[n]->size();
+        }
+    }
+    // Collective over the warp: appends check to list n for each lane with take[n].
+    __device__ void append(Array<bool, nLists> const& take, int check) {
+        unsigned const lowerLanes = (1u << threadIdx.x) - 1u;
+        for (int n = 0; n < nLists; n++) {
+            unsigned const lanes = __ballot_sync(0xFFFFFFFF, take[n]);
+            if (lanes) {
+                int const count = __popc(lanes);
+                if (sizes_[n] + count > lists_[n]->capacity()) {
+                    // Publish the entries written so far, so the move keeps them.
+                    lists_[n]->setSize(sizes_[n]);
+                    lists_[n]->reserve(sizes_[n] + count);
+                }
+                if (take[n]) {
+                    lists_[n]->data()[sizes_[n] + __popc(lanes & lowerLanes)] = check;
+                }
+                sizes_[n] += count;
+            }
+        }
+    }
+    // Collective: publish the appended sizes to the vectors.
+    __device__ void flush() {
+        for (int n = 0; n < nLists; n++) {
+            if (sizes_[n] != lists_[n]->size()) {
+                lists_[n]->setSize(sizes_[n]);
+            }
+        }
+    }
+};
+
