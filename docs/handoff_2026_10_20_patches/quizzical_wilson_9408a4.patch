+// The kick walks evaluate the derivatives in float (SIMD lanes on the CPU,
+// scalars in the kernel). Every rank must match the double evaluation to near
+// float rounding, also at the small separations of neighbouring cells, where
+// an upward recurrence for the nearest image's erf(alpha r) / r lost all of
+// its high ranks (box/8 cells sit 1/8 apart, box/16 cells 1/16).
+template <int order>
+void checkFloatDerivatives() {
+    constexpr std::array<Position, 8> kPositions{{{.125, 0., 0.}, {.0625, .0625, 0.},
+        {.125, -.125, .125}, {.0625, .03, -.02}, {.01, .005, -.002}, {.25, .125, 0.},
+        {.4, -.3, .45}, {-.499, .497, -.11}}};
+    for (auto const& position : kPositions) {
+        Array<double, NDIM> separation;
+        Array<SimdFloat, NDIM> floatSeparation;
+        for (int d = 0; d < 3; ++d) {
+            separation[d] = position[d];
+            floatSeparation[d] = simdBroadcast<SimdFloat>(float(position[d]));
+        }
+        SymmetricTracelessTensor<double, order> expected;
+        SymmetricTracelessTensor<SimdFloat, order> actual;
+        ewaldCorrectionDerivatives(expected, separation);
+        ewaldCorrectionDerivatives(actual, floatSeparation);
+        for (int rank = 0; rank < order; ++rank) {
+            // The trace entry (0, 0, 2) belongs to rank two.
+            auto const components = [&](auto&& visit) {
+                for (int nz = 0; nz <= 1 && nz <= rank; ++nz) {
+                    for (int nx = 0; nx <= rank - nz; ++nx) {
+                        visit(nx, rank - nx - nz, nz);
+                    }
+                }
+                if (rank == 2) {
+                    visit(0, 0, 2);
+                }
+            };
+            // Near the origin the cubic symmetry leaves the low ranks small, so
+            // measure them against the alpha^(rank + 1) scale of the nearest
+            // image's derivatives.
+            double scale = std::pow(kAlpha / SCALE_FACTOR, rank + 1);
+            components([&](int nx, int ny, int nz) {
+                scale = std::max(scale, std::abs(expected(nx, ny, nz)));
+            });
+            components([&](int nx, int ny, int nz) {
+                double const value = actual(nx, ny, nz)[0];
+                requireNear(value, expected(nx, ny, nz), 5e-5 * scale,
+                    "CPU Ewald float derivatives against double");
+            });
+        }
+    }
+}
+
